# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=rag_documents

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval ---
TOP_K=5
FETCH_K=20
MULTI_QUERY_COUNT=3

# --- Cohere Rerank (leave empty to skip reranking) ---
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# --- Neo4j Graph RAG (leave URI empty to disable graph features) ---
# Local Docker:  bolt://localhost:7687   |   Neo4j Aura:  neo4j+s://xxxx.databases.neo4j.io
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
GRAPH_EXTRACTION_ON_INGEST=true

# --- Guardrails ---
GUARDRAILS_ENABLED=true
GUARDRAIL_INJECTION=true          # heuristic prompt-injection detection (blocks)
GUARDRAIL_MODERATION=true         # OpenAI moderation on the query (blocks)
GUARDRAIL_INPUT_PII=true          # detect PII in the question (flags)
GUARDRAIL_OUTPUT_PII=true         # redact PII from the answer (Presidio)
GUARDRAIL_GROUNDING=false         # LLM faithfulness check (adds a call; flags)
BLOCK_ON_INPUT_PII=false          # true = reject queries containing PII
PII_SCORE_THRESHOLD=0.5

# --- Logfire (leave empty to log locally only) ---
LOGFIRE_TOKEN=

# --- App ---
ENVIRONMENT=development
